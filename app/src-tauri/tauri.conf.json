{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula",
  "version": "1.4.0",
  "identifier": "org.devlive.nebula",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nebula",
        "width": 1160,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devlive-community/nebula/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNDVFMjVCQjU1RjVEOEIKUldTTFhWKzFXK0pGNDJ6Wk5WTGlRdlA4WmJGTlRLSktSbmhpVFYyUzIzL0sxQ1VpRk82QXFWTzgK"
    }
  }
}
